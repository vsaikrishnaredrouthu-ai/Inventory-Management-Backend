# Copy this file to .env and fill in the values. Never commit .env to GitHub.

# Supabase: Project Settings > Database > Connection string (URI, Session pooler).
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_SSL=true

# At least 16 random characters, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

PORT=5000
NODE_ENV=development
JWT_EXPIRES=8h
JWT_REMEMBER_EXPIRES=30d

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Build the frontend (npm run build in the frontend folder) and set this to its dist folder
# to serve the whole app from one server, e.g. ../inventory-frontend/dist
# FRONTEND_DIST=

ALERT_SCAN_MINUTES=60
SUPPORT_EMAIL=support@yourcompany.example
